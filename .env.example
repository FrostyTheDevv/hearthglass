# Hearthglass Game — Environment Configuration Template
# Copy this file to .env and customize values for local development.

# Server & Networking
PORT=4173
HOST=127.0.0.1
NODE_ENV=development

# Authoritative Persistence (PostgreSQL / Embedded PGlite)
# Leave DATABASE_URL empty or unset to use embedded disk-persisted PGlite (data/pgdata)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hearthglass
PGLITE_DATA_DIR=data/pgdata

# Rust Authoritative Battle Server
RUST_BATTLE_SERVER_BIN=target/debug/hearthglass-battle-server

# AI Card Artwork Production Pipeline (Optional / Hosted APIs)
# Required only when generating final production raster illustrations
FLUX_API_KEY=your_flux_api_key_here
Z_IMAGE_API_KEY=your_z_image_api_key_here
QWEN_IMAGE_API_KEY=your_qwen_image_api_key_here
TOGETHER_API_KEY=your_together_api_key_here
COMFYUI_REMOTE_URL=http://127.0.0.1:8188
