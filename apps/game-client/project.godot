; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Hearthglass — Convergence Duels"
config/description="Original Isometric Open-World Card-Battling RPG"
config/version="0.1.0"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
ConvergenceRules="*res://scripts/engine/convergence_rules.gd"
SoundManager="*res://scripts/autoload/sound_manager.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[rendering]

anti_aliasing/quality/msaa_3d=2
